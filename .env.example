APP_NAME="IPO Enquiry & Suggester Service"
APP_VERSION="1.0.0"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL asyncpg or SQLite aiosqlite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=ipo_db
DATABASE_URL="postgresql+asyncpg://postgres:your_secure_postgres_password@postgres:5432/ipo_db"
# DATABASE_URL="sqlite+aiosqlite:///./ipo.db"

# Background Scraper Settings
SCRAPER_ENABLED=True
SCRAPER_INTERVAL_MINUTES=15

# Link Intime Registrar URLs
LINK_INTIME_BASE_URL="https://in.mpms.mufg.com/Initial_Offer/public-issues.html"
LINK_INTIME_API_URL="https://in.mpms.mufg.com/Initial_Offer/IPO.aspx"
REQUEST_TIMEOUT_SECONDS=10.0

# CORS Allowed Origins
CORS_ORIGINS=["https://ipopulse-app.duckdns.org", "http://localhost:8000", "http://127.0.0.1:8000"]

# Authentication (Single-User Admin)
ADMIN_USERNAME=admin
# Compute SHA-256 hash using: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
ADMIN_PASSWORD_HASH=your_sha256_hash_of_password
JWT_SECRET_KEY=your_random_secret_jwt_key

# Telegram Bot Notifications (Optional)
# 1. Create a bot via @BotFather on Telegram to obtain TELEGRAM_BOT_TOKEN
# 2. Get your Chat ID by messaging your bot and querying https://api.telegram.org/bot<TOKEN>/getUpdates
#    or messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_NOTIFICATIONS_ENABLED=True
TELEGRAM_MIN_SCORE=65.0
TELEGRAM_MIN_GMP_PCT=20.0
TELEGRAM_MAINBOARD_ONLY=True
TELEGRAM_WEBHOOK_SECRET=your_secret_webhook_token

# Groq LLM Settings (Supports Smart Switching across multiple API keys)
GROQ_API_KEY=gsk_your_primary_groq_api_key
GROQ_API_KEY2=gsk_your_second_groq_api_key
GROQ_API_KEY3=gsk_your_third_groq_api_key
GROQ_API_KEY4=gsk_your_fourth_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini LLM Settings (Smart Shifting with Groq)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
PRIMARY_LLM_PROVIDER=gemini

